{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horneroos.com/schemas/shell-plugin-manifest-v1.json",
  "title": "Hornero Shell Plugin Manifest",
  "description": "Metadata contract for community-authored Hornero Shell extensions. This schema does not define a sandbox or runtime loader. Cross-field rules that JSON Schema cannot express (surfaces requires schemaVersion 2, a redeclared primary surface must reuse the top-level entrypoint, translation catalog completeness for literal tr() strings, setting constraint consistency) are enforced by scripts/validate_plugins.py and the shell validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "author",
    "license",
    "entrypoint",
    "files",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S" },
    "version": {
      "maxLength": 80,
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 280, "pattern": "\\S" },
    "author": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "license": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
    "homepage": { "type": "string", "maxLength": 500, "format": "uri", "pattern": "^https://[^\\s/]+(?:/.*)?$" },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicKey", "signature"],
      "properties": {
        "publicKey": { "type": "string", "minLength": 40, "maxLength": 80, "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
        "signature": { "type": "string", "minLength": 80, "maxLength": 120, "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
      },
      "description": "Optional author signature (minisign framing) over the files-only payload hash; verified by horneroctl (trust state 'signed'). Absence is fine: local hash-pinned trust applies instead."
    },
    "placement": { "type": "string", "enum": ["background", "bar", "dashboard", "desktop"], "default": "background", "description": "Where the entrypoint runs: background (headless, default), bar (rendered in the bar end group) or dashboard (rendered as a card in the dashboard Extensions tab) or desktop (rendered as a widget on the desktop background layer)." },
    "surfaces": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "enum": ["background", "bar", "dashboard", "desktop", "launcher", "settings"] },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entrypoint"],
        "properties": {
          "entrypoint": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._/-]+\\.qml$"
          },
          "enabled": { "type": "boolean", "default": true },
          "size": { "type": "string", "enum": ["compact", "standard", "wide"], "default": "standard", "description": "Dashboard surface only (shell#378): preferred card size class. A hint the user's persisted layout overrides; declaring it on another surface is rejected by the validators, not by this structural schema." },
          "category": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S", "description": "Dashboard surface only (shell#378): grouping label (\"Pinned\" is reserved). Same enforcement split as size." }
        }
      },
      "description": "Manifest v2 only (schemaVersion 2): additional per-surface entry points. The top-level entrypoint/placement pair stays the primary surface; redeclaring it here requires the same entrypoint. launcher/settings are validated declarations whose hosts do not load them yet."
    },
    "translations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceLocale", "locales"],
      "properties": {
        "sourceLocale": { "type": "string", "pattern": "^[a-z]{2,3}(_[A-Z]{2})?$" },
        "locales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]{2,3}(_[A-Z]{2})?$" }
        },
        "directory": { "type": "string", "maxLength": 240, "default": "translations" }
      },
      "description": "Optional PluginKit Translations declaration: one flat JSON catalog per locale at <directory>/<locale>.json, each listed in files. Plugin QML reads strings through Translations.tr(); qsTr() is rejected because the shell installs no QTranslator for plugins."
    },
    "marketplace": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Optional marketplace metadata (shell#379, any schemaVersion) rendered without executing plugin code. Cross-field rules (screenshot listed in files, minShellVersion <= maxShellVersion, replacedBy != own id) are enforced by the validators.",
      "properties": {
        "screenshots": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path"],
            "properties": {
              "path": { "type": "string", "maxLength": 240, "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._/-]+\\.(?:png|jpg|jpeg|webp)$" },
              "alt": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" }
            }
          }
        },
        "compatibility": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {
            "minShellVersion": { "type": "string", "maxLength": 80, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
            "maxShellVersion": { "type": "string", "maxLength": 80, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" }
          }
        },
        "changelog": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["version", "notes"],
            "properties": {
              "version": { "type": "string", "maxLength": 80, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
              "notes": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" }
            }
          }
        },
        "deprecation": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "message": { "type": "string", "minLength": 1, "maxLength": 280, "pattern": "\\S" },
            "replacedBy": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" }
          }
        }
      }
    },
    "entrypoint": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._/-]+\\.qml$"
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "allOf": [
        { "contains": { "const": "README.md" } },
        { "contains": { "const": "LICENSE" } }
      ],
      "items": {
        "type": "string",
        "maxLength": 240,
        "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$",
        "not": { "const": "manifest.json" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processCommands", "networkHosts", "settings"],
      "properties": {
        "processCommands": {
          "description": "Exact executable basenames the extension may invoke. Declarations are review metadata, not enforcement.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!(?:[sS][hH]|[bB][aA][sS][hH]|[dD][aA][sS][hH]|[zZ][sS][hH]|[fF][iI][sS][hH]|[sS][uU][dD][oO]|[dD][oO][aA][sS]|[sS][uU])$)[A-Za-z0-9_.+-]+$"
          }
        },
        "networkHosts": {
          "description": "Network hostnames the extension intends to contact. Declarations are review metadata, not enforcement.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$" }
        },
        "actions": {
          "description": "Optional horneroctl plugin-broker action names (HorneroOS/hornero#408), snake_case. Declarations are review metadata; the broker enforces trust, declaration, typed argv and ABAC at call time.",
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
        },
        "settings": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9]{0,47}$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "default"],
            "properties": {
              "type": { "enum": ["boolean", "integer", "number", "string", "enum"] },
              "default": { "type": ["boolean", "integer", "number", "string"] },
              "description": { "type": "string", "maxLength": 160, "pattern": "\\S" },
              "minimum": { "type": "number" },
              "maximum": { "type": "number" },
              "minLength": { "type": "integer", "minimum": 0, "maximum": 4096 },
              "maxLength": { "type": "integer", "minimum": 0, "maximum": 4096 },
              "options": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 64 }
              }
            },
            "description": "Typed setting (shell #374): constraints belong to their type only (minimum/maximum for integer/number, minLength/maxLength for string, options required for enum) and the default must satisfy them; the validator enforces the cross-field rules.",
            "oneOf": [
              { "properties": { "type": { "const": "boolean" }, "default": { "type": "boolean" } } },
              { "properties": { "type": { "const": "integer" }, "default": { "type": "integer" } } },
              { "properties": { "type": { "const": "number" }, "default": { "type": "number" } } },
              { "properties": { "type": { "const": "string" }, "default": { "type": "string" } } },
              { "properties": { "type": { "const": "enum" }, "default": { "type": "string" } } }
            ]
          }
        }
      }
    }
  }
}
